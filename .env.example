LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TRUST_ENV_PROXY=false
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DATABASE_URL=sqlite:///./data/medessence.db
CHROMA_PERSIST_DIR=./data/chroma
MAX_CHAPTER_NODES=30
MIN_CHAPTER_NODES=5
CHUNK_SIZE=600
CHUNK_OVERLAP=80
COMPRESSION_TARGET=0.30
SIMILARITY_THRESHOLD_HIGH=0.92
SIMILARITY_THRESHOLD_LOW=0.82
QUALITY_THRESHOLD=0.65
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
MAX_UPLOAD_SIZE_MB=50
PUBLIC_DEMO_READ_ONLY=false
SEED_DEMO_DATA=false
